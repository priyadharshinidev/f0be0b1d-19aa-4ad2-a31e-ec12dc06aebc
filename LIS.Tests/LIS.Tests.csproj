<Project Sdk="Microsoft.NET.Sdk">
  <!-- Builds the xUnit test project for the LIS implementation. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <CollectCoverageFrom>
      <![CDATA[
        ../LIS.Cli/**/*.cs,
        !../LIS.Cli/**/obj/**,
        !../LIS.Cli/**/bin/**
      ]]>
    </CollectCoverageFrom>
  </PropertyGroup>
  <ItemGroup>
    <!-- Test framework, test runner, and code coverage dependencies. -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.2.1" />
    <PackageReference Include="xunit" Version="2.6.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.6.2" />
    <PackageReference Include="coverlet.collector" Version="3.2.0" />
    <PackageReference Include="coverlet.msbuild" Version="3.2.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <!-- Allows tests to call the production solver directly. -->
    <ProjectReference Include="..\LIS.Cli\LIS.Cli.csproj" />
  </ItemGroup>
</Project>
