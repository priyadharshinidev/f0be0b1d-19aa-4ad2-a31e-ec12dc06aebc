{
  "version": "0.2.0",
  "configurations": [
    {
      "name": ".NET Core Launch (console)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/LIS.Cli/bin/Debug/net8.0/LIS.Cli.dll",
      "runtimeExecutable": "${env:USERPROFILE}\\.dotnet\\dotnet.exe",
      "env": {
        "DOTNET_ROOT": "${env:USERPROFILE}\\.dotnet"
      },
      "args": ["1", "5", "2", "3", "4", "9"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopAtEntry": false
    }
  ]
}
